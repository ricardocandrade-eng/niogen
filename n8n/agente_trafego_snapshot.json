      "parameters": {
        "method": "POST",
        "url": "https://zlrfwbkblytnokuexjti.supabase.co/rest/v1/rpc/agente_trafego_retrato",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"p_dias\": 14}",
