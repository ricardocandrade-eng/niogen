      "name": "2 · Supabase retrato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "id": "b25c6655-233f-57a0-ad4f-6fd452ac8616",
      "credentials": {
        "supabaseApi": {
          "id": "p59RBqdhm80tQqJq",
          "name": "Supabase Nio (service role)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// O retrato vem pronto do banco (agente_trafego_retrato). Aqui só vira texto e ganha os 2 nomes de arquivo.\nconst r = $input.first().json;\nif (!r || !r.gerado_em || !r.totais) throw new Error('retrato vazio ou sem totais — nada foi gravado');\nconst txt = JSON.stringify(r, null, 2);\nconst dia = $now.setZone('America/Sao_Paulo').toFormat('ddMMyy');\nreturn ['funil_agente_trafego.json', `funil_agente_trafego_${dia}.json`]\n  .map((nome) => ({ json: { nome, conteudo: txt } }));"
      },
      "name": "3 · Preparar arquivos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ],
      "id": "aa1de719-5ca4-5ebe-8755-3f9fbda9dea1"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "timeout": 30000
        },
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ \"name = '\" + $json.nome + \"' and '1Xmwr5XHs-0nUYkkV2XyzEbL-6YnBDj9Q' in parents and trashed = false\" }}"
            },
            {
              "name": "fields",
              "value": "files(id,name,modifiedTime)"
            },
            {
              "name": "spaces",
              "value": "drive"
            }
          ]
        }
      },
      "name": "4 · Drive procurar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        100
      ],
      "id": "6da94a3e-2771-5c5f-ae89-45dbe27995f7",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "aPnrkEhc9IzKXm7g",
          "name": "Google Drive Nio (agente de tráfego)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Achou o arquivo na pasta → troca só o conteúdo (mesmo ID). Não achou → cria com multipart (metadados + conteúdo).\nconst p = $('3 · Preparar arquivos').item.json;\nconst id = (($json.files || [])[0] || {}).id;\nif (id) {\n  return { json: { nome: p.nome, acao: 'atualizado', metodo: 'PATCH',\n    url: `https://www.googleapis.com/upload/drive/v3/files/${id}?uploadType=media&fields=id,name,modifiedTime`, tipo: 'application/json; charset=UTF-8', corpo: p.conteudo } };\n}\nconst b = `niogen_${Date.now()}`;\nconst meta = JSON.stringify({ name: p.nome, parents: ['1Xmwr5XHs-0nUYkkV2XyzEbL-6YnBDj9Q'], mimeType: 'application/json' });\nconst corpo = `--${b}\\r\\nContent-Type: application/json; charset=UTF-8\\r\\n\\r\\n${meta}\\r\\n`\n  + `--${b}\\r\\nContent-Type: application/json; charset=UTF-8\\r\\n\\r\\n${p.conteudo}\\r\\n--${b}--`;\nreturn { json: { nome: p.nome, acao: 'criado', metodo: 'POST',\n  url: 'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,name,modifiedTime', tipo: `multipart/related; boundary=${b}`, corpo } };"
      },
      "name": "5 · Montar gravação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
