      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Só os diários (funil_agente_trafego_DDMMAA.json) com mais de 30 dias; o arquivo principal nunca entra.\nconst arqs = $input.first().json.files || [];\nreturn arqs.filter((f) => /^funil_agente_trafego_\\d{6}\\.json$/.test(f.name || ''))\n  .map((f) => ({ json: { id: f.id, nome: f.name, modificado: f.modifiedTime } }));"
      },
