            {
              "name": "q",
              "value": "={{ \"name contains 'funil_agente_trafego_' and '1Xmwr5XHs-0nUYkkV2XyzEbL-6YnBDj9Q' in parents and trashed = false and modifiedTime < '\" + $now.minus({ days: 30 }).toUTC().toISO() + \"'\" }}"
