    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 3b · Montar etiquetas — UNIÃO das etiquetas atuais (GET) com as novas, tirando só as que o momento manda tirar.\n// Leitura falhou → não posta nada (postar só as novas apagaria as atuais: POST /labels substitui a lista).\nconst a = $('3 · Etiquetas?').item.json;\nconst r = $json || {};\nif (r.error || !Array.isArray(r.payload)) {\n  return { json: { ...a, erroLeitura: 'não li as etiquetas atuais: ' + JSON.stringify(r.error || r).slice(0, 300) } };\n}\nconst tirar = new Set(a.remove || []);\nconst labels = [...new Set([...r.payload, ...(a.add || [])])].filter((l) => !tirar.has(l));\nreturn { json: { ...a, corpo: { labels } } };\n"
      },
      "name": "3b · Montar etiquetas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -160
      ],
      "id": "43583d71-e2fb-5854-a948-59a92008964f"
    },
