    {
      "parameters": {
        "jsCode": "// Depois de fechar a varredura: volta sem nenhuma leitura boa derruba a execução (aparece no pulso).\nconst r = $('12 · Resumo').first().json;\nif (r.falha) throw new Error('Operador de OS: nenhuma OS lida nesta volta (' + r.erros + ' com erro) — ' + ((r.motivos || [])[0] || 'sem motivo'));\nreturn [{ json: r }];"
      },
