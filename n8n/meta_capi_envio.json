    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://zlrfwbkblytnokuexjti.supabase.co/rest/v1/rpc/meta_capi_marcar",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const c = $json.statusCode || 0; const b = $json.body || {}; const ok = c >= 200 && c < 300 && (b.events_received || 0) > 0; return JSON.stringify({ p_id: $('3 · Montar eventos').item.json.fila_id, p_status: ok ? 'enviado' : 'erro', p_http: c, p_resposta: JSON.stringify(b).slice(0, 500), p_fbtrace: b.fbtrace_id || (b.error && b.error.fbtrace_id) || null }); })() }}",
        "options": {
          "timeout": 20000
        }
      },
      "name": "5 · Supabase marcar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
