      "id": "d023ce81-6321-5177-96af-4c6568f78321",
      "credentials": {
        "supabaseApi": {
          "id": "p59RBqdhm80tQqJq",
          "name": "Supabase Nio (service role)"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $json || {};\nconst dataset = r.dataset_id;\nconst versao = r.graph_versao || 'v23.0';\nconst teste = r.test_event_code || null;\nconst eventos = Array.isArray(r.eventos) ? r.eventos : [];\nif (!dataset) { throw new Error('config_regras.meta_capi sem dataset_id'); }\n\nconst saida = [];\nfor (const ev of eventos) {\n  const fila = ev.fila || {};\n  const evento = { ...ev };\n  delete evento.fila;\n  if (evento.custom_data === null) { delete evento.custom_data; }\n  const corpo = { data: [evento], partner_agent: 'niogen' };\n  if (teste) { corpo.test_event_code = teste; }\n  saida.push({ json: {\n    fila_id: fila.id,\n    tentativas: fila.tentativas,\n    event_name: evento.event_name,\n    event_id: evento.event_id,\n    url: 'https://graph.facebook.com/' + versao + '/' + dataset + '/events',\n    corpo,\n  } });\n}\nreturn saida;"
      },
      "name": "3 · Montar eventos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ],
      "id": "5334283d-55b7-5bb5-8cf6-fbe7d5ef682d"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.corpo) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "name": "4 · Meta evento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
