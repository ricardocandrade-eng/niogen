{
  "manifest_version": 3,
  "name": "NIOGEN no Portal",
  "version": "0.1.0",
  "description": "Painel lateral do NIOGEN sobre o portal PAP da Nio: mostra as vendas prontas e preenche os campos da etapa aberta do Novo Pedido. A pessoa confere e clica em tudo.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://pap.niointernet.com.br/*",
    "https://zlrfwbkblytnokuexjti.supabase.co/*"
  ],
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "NIOGEN no Portal",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://pap.niointernet.com.br/administrativo/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
